# Public app
APP_BASE_URL=https://worldcup.svtool.info
PUBLIC_WEB_URL=https://worldcup.svtool.info
NODE_ENV=development

# Server
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/svworldcup
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=svworldcup
DB_USER=svworldcup
DB_PASS=replace-with-db-password

# Email / double opt-in
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="Soccerverse World Cup <mailer@example.com>"

# Soccerverse APIs
SV_SERVICES_API_URL=https://services.soccerverse.com/api
COMMUNITY_PACK_URL=https://elrincondeldt.com/sv/rincon_v2.json
SV_GSP_API_URL=https://gsppub.soccerverse.io/

# Admin bootstrap
ADMIN_BOOTSTRAP_EMAILS=admin1@example.com,admin2@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# Tournament lock
TOURNAMENT_KICKOFF_AT=
# Registration closes at the Soccerverse season transition (player ratings/wages change here).
# After this instant no squad can be created or edited. Leave blank to use the default
# 2026-07-04T00:00:00Z (unix 1783123200); set an ISO-8601 instant to override (e.g. for testing).
REGISTRATION_CLOSE_AT=

# Analytics / app security
CLOSED_BETA_AUTH_ENABLED=true
CLOSED_BETA_AUTH_USERNAME=soccerverse
CLOSED_BETA_AUTH_PASSWORD=soccerverse
RATE_LIMIT_TRUST_PROXY=true
SHARE_SNAPSHOT_SECRET=replace-with-a-long-random-share-secret
CSRF_TOKEN_SECRET=replace-with-a-long-random-csrf-secret
RISK_SIGNAL_SECRET=replace-with-a-long-random-risk-secret
